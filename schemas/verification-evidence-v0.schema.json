{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.starknet.org/source-verification/verification-evidence-v0.schema.json",
  "title": "Starknet Cairo source-verification evidence v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "recordId",
    "evidenceDigest",
    "evidence",
    "timing"
  ],
  "properties": {
    "schema": {
      "const": "org.starknet.source-verification.evidence"
    },
    "schemaVersion": {
      "const": "0.1.0-draft"
    },
    "recordId": {
      "type": "string",
      "pattern": "^urn:starknet-source-verification:sha256:[0-9a-f]{64}$"
    },
    "evidenceDigest": {
      "$ref": "#/$defs/digest"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "subject",
        "source",
        "build",
        "outcome"
      ],
      "properties": {
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "policy"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]*$"
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "digest"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]*$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
                },
                "digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classHash",
            "submissionChainId",
            "declarationEvidence"
          ],
          "properties": {
            "classHash": {
              "$ref": "#/$defs/felt"
            },
            "submissionChainId": {
              "$ref": "#/$defs/chainId"
            },
            "declarationEvidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chainId",
                "finality",
                "blockNumber",
                "transactionHash",
                "sourceType",
                "responseDigest"
              ],
              "properties": {
                "chainId": {
                  "$ref": "#/$defs/chainId"
                },
                "finality": {
                  "const": "accepted_on_l1"
                },
                "blockNumber": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "transactionHash": {
                  "$ref": "#/$defs/felt"
                },
                "sourceType": {
                  "enum": [
                    "starknet_json_rpc",
                    "starknet_state_archive"
                  ]
                },
                "responseDigest": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            "contractReferences": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/felt"
              }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundleDigest",
            "treeDigest",
            "scarbManifestDigest",
            "scarbLockDigest",
            "materialManifestDigest",
            "visibility",
            "retention",
            "redistribution"
          ],
          "properties": {
            "bundleDigest": {
              "$ref": "#/$defs/digest"
            },
            "treeDigest": {
              "$ref": "#/$defs/digest"
            },
            "scarbManifestDigest": {
              "$ref": "#/$defs/digest"
            },
            "scarbLockDigest": {
              "$ref": "#/$defs/digest"
            },
            "materialManifestDigest": {
              "$ref": "#/$defs/digest"
            },
            "visibility": {
              "enum": ["public", "private", "restricted", "unknown"]
            },
            "retention": {
              "enum": [
                "digest_only",
                "retained_private",
                "retained_public",
                "not_retained"
              ]
            },
            "redistribution": {
              "enum": ["allowed", "not_allowed", "unknown"]
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+:/()-]*$"
            }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "target",
            "profile",
            "artifact",
            "module",
            "toolchain",
            "environmentDigest",
            "buildLogDigest",
            "producedClassHash"
          ],
          "properties": {
            "package": {
              "$ref": "#/$defs/selector"
            },
            "target": {
              "$ref": "#/$defs/selector"
            },
            "profile": {
              "$ref": "#/$defs/selector"
            },
            "artifact": {
              "$ref": "#/$defs/relativePath"
            },
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_]+(?:::[A-Za-z0-9_]+)*$"
            },
            "toolchain": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scarbVersion",
                "cairoVersion",
                "sierraVersion",
                "compilerDigest"
              ],
              "properties": {
                "scarbVersion": {
                  "$ref": "#/$defs/version"
                },
                "cairoVersion": {
                  "$ref": "#/$defs/version"
                },
                "sierraVersion": {
                  "$ref": "#/$defs/version"
                },
                "compilerDigest": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            "environmentDigest": {
              "$ref": "#/$defs/digest"
            },
            "buildLogDigest": {
              "$ref": "#/$defs/digest"
            },
            "producedClassHash": {
              "$ref": "#/$defs/felt"
            }
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reasonCode", "receiptEligible"],
          "properties": {
            "status": {
              "enum": [
                "exact_match",
                "confirmed_mismatch",
                "rejected_input",
                "build_failed",
                "infrastructure_failed"
              ]
            },
            "reasonCode": {
              "enum": [
                "class_hash_equal",
                "class_hash_not_equal",
                "invalid_evidence",
                "policy_rejected",
                "build_nonzero_exit",
                "build_timeout",
                "trusted_service_unavailable",
                "trusted_storage_failure"
              ]
            },
            "receiptEligible": {
              "type": "boolean"
            }
          }
        },
        "extensions": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^org\\.[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
          },
          "additionalProperties": {
            "type": ["object", "array", "string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt"],
      "properties": {
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  },
  "$defs": {
    "chainId": {
      "enum": ["SN_MAIN", "SN_SEPOLIA"]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "felt": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._+/-]+$"
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    }
  }
}

